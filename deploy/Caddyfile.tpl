# Generated by deploy/install.sh — do not edit by hand; re-run install or edit APP_HOSTNAME.
__APP_HOSTNAME__ {
	encode gzip
	# Security headers for the whole site including /api (nginx also sets some for static UI).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}
	reverse_proxy web:80
}
