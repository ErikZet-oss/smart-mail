# Generated by deploy/install.sh — do not edit by hand; re-run install or edit APP_HOSTNAME.
__APP_HOSTNAME__ {
	encode gzip
	# Security headers for the whole site including /api (nginx also sets some for static UI).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}
	# Strip CF-Connecting-IP so a client cannot spoof it through Caddy → nginx (D26).
	reverse_proxy web:80 {
		header_up -CF-Connecting-IP
	}
}
