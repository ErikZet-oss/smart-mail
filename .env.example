# Smart Mail — environment variables (CLAUDE.md §13). Copy to `.env` and fill in. NEVER commit `.env`.
# docker compose has safe defaults for local development; production needs every "required" value.

# ---------------------------------------------------------------- app (main service + worker)
APP_ENV=dev                                   # dev | test | prod
APP_BASE_URL=http://localhost:8080            # public URL of the web app (links in e-mails, OIDC redirects)
APP_SECRET_KEY=change-me                      # required in prod: random 64+ chars, signs sessions and CSRF tokens
APP_ENCRYPTION_KEY=                           # required in prod: Fernet key for mailbox passwords and tokens at rest (D27);
                                              #   only here / in a secret file, never logged; losing it = everybody logs in once again
                                              #   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABASE_URL=postgresql+asyncpg://smartmail:smartmail@localhost:5432/smartmail
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:8333             # SeaweedFS S3 in compose (ADR-002); any S3-compatible storage in prod
S3_BUCKET=smartmail
S3_ACCESS_KEY=smartmail
S3_SECRET_KEY=smartmail-dev-secret
STORAGE_BACKEND=s3                            # s3 (default, Phase 1e+) | local (unit tests only)
STORAGE_PATH=./data/storage                   # used only when STORAGE_BACKEND=local
SMTP_HOST=localhost                           # Mailpit in compose (Phase 1e outbound); prod = mailbox SMTP
SMTP_PORT=1025
SMTP_SECURITY=none                            # ssl | starttls | none
UNDO_SEND_SECONDS=10                          # toast Späť window (0–30)
MAIL_SEND_ALLOW_REAL_SERVER=false             # outside prod: SMTP only to Mailpit/localhost unless true
                                              #   (mirrors MAIL_SYNC_ALLOW_REAL_SERVER); never live eshop@/info@
MAIL_SEND_TEST_ALLOWLIST=                     # comma-separated extra To/Cc/Bcc allowed outside prod
                                              #   (@smartmail.test is always allowed; e.g. qa@example.test)
CLAMAV_HOST=localhost                         # attachments scanned at latest in Phase 1h (av_status=skipped until then)
INTERNAL_DOMAINS=smartsro.sk,smartmail.test  # comma-separated (smartmail.test = fictional test server); e-mail outside these = external (AI may never send);
                                              #   a first login from these domains creates a read-only account (D25)
LOG_LEVEL=INFO
SENTRY_DSN=                                   # optional

# ---------------------------------------------------------------- mailbox login (Phase 1a, PRODUCT_SPEC §2.0)
# Dev = the local TEST server of docker compose (imap-test, fictional mailboxes, `make imap-seed`); compose already
# sets these defaults. Production: IMAP_LOGIN_HOST=mail2.nameserver.sk, IMAP_LOGIN_PORT=993, IMAP_LOGIN_SECURITY=ssl.
IMAP_LOGIN_HOST=imap-test                     # the IMAP server Roundcube uses; every login is verified there
IMAP_LOGIN_PORT=143
IMAP_LOGIN_SECURITY=none                      # ssl | starttls | none (none = the local test server only, refused in prod)
IMAP_LOGIN_TIMEOUT_S=10                       # slower answer = "Mailový server je nedostupný"
SESSION_IDLE_HOURS=12                         # logout after inactivity (CLAUDE.md §11)
SESSION_REMEMBER_DAYS=30                      # "Zostať prihlásený" (max 30; a branch can lower it to 7 or 1)
LOGIN_MAX_FAILURES=5                          # wrong attempts per account before the lock
LOGIN_IP_MAX_FAILURES=30                      # wrong attempts per client IP in the window (D26)
LOGIN_IP_ALLOWLIST=                           # company IPs / CIDR networks without the IP limit, e.g. 203.0.113.10,198.51.100.0/24

# ---------------------------------------------------------------- mail sync (Phase 1c, CLAUDE.md §5)
MAIL_SYNC_ENABLED=true                        # IDLE on INBOX + poll of the other subscribed folders (worker)
MAIL_POLL_SECONDS=120                         # poll interval of the subscribed folders except INBOX
MAIL_IDLE_RENEW_SECONDS=1500                  # re-IDLE every 25 min (servers drop IDLE after 30 min)
MAIL_SYNC_BATCH=500                           # max UIDs fetched per IMAP FETCH in one sync pass
MAIL_SYNC_ALLOW_REAL_SERVER=false             # outside prod the sync connects only to the local test server
                                              #   (imap-test, localhost); true only with the TEST mailbox of 1f
# Integration test against the real server (tests/integration/test_real_mailbox.py, skipped when empty). Only the
# dedicated TEST mailbox the customer provides — never eshop@, info@ or a branch mailbox. Read-only checks.
REAL_IMAP_TEST_HOST=                          # mail2.nameserver.sk
REAL_IMAP_TEST_PORT=993
REAL_IMAP_TEST_EMAIL=
REAL_IMAP_TEST_PASSWORD=
LOGIN_LOCK_MINUTES=5
MFA_MAX_FAILURES=5                            # wrong 2FA codes before the pending login is cancelled
MFA_TRUST_DAYS=30                             # "Zapamätať zariadenie na 30 dní"
ADMIN_EMAILS=                                 # comma-separated; these addresses get the admin role when their account is created (D25)
ADMIN_CONTACT_EMAIL=                          # W16a "Požiadať správcu" opens a mail to this address, e.g. it@smartsro.sk
LOGIN_ALLOWLIST=                              # who may sign in; empty = everyone in INTERNAL_DOMAINS; deploy default test@smartsro.sk
FEATURE_MONEY=false                           # hide Money / Doklady UI (pilot keeps mock bridge, FEATURE_MONEY=false)
FORWARDED_ALLOW_IPS=*                         # uvicorn: proxies whose X-Forwarded-For is trusted (prod: the nginx IP)

# ---------------------------------------------------------------- optional sign-in providers (default = mailbox login)
OIDC_MS_CLIENT_ID=
OIDC_MS_CLIENT_SECRET=
OIDC_MS_TENANT_ID=
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- Web Push (Phase 5)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------- AI (Phase 2, AI_ASSISTANT.md)
LLM_PROVIDER=anthropic                        # anthropic | bedrock (EU region recommended)
ANTHROPIC_API_KEY=
AWS_REGION=eu-central-1
LLM_MODEL_CLASSIFY=                           # model ids are configuration, never hard-coded
LLM_MODEL_DRAFT=
LLM_MODEL_EXTRACT=
LLM_MODEL_ASSISTANT=
LLM_MODEL_EMBED=
AI_DAILY_BUDGET_USD=5                         # hard daily cost cap; AI pauses when reached, mail keeps working

# ---------------------------------------------------------------- Money bridge client (main app side)
BRIDGE_URL=http://localhost:8100
BRIDGE_HMAC_KEY_ID=dev
BRIDGE_HMAC_SECRET=change-me                  # same value as in the bridge
APPROVAL_JWT_PRIVATE_KEY=                     # signs single-use approval tokens for Money writes (Phase 4)
ESHOP_FEED_URL=                               # optional product feed (Phase 6)

# ---------------------------------------------------------------- bridge service (runs in the LAN next to Money S4)
MONEY_BACKEND=mock                            # mock | api — keep mock until the TEST agenda and probe report exist
MONEY_BASE_URL=                               # e.g. https://money.local:44333 (TEST agenda first!)
MONEY_CLIENT_ID=
MONEY_CLIENT_SECRET=
MONEY_SCOPE=S5Api
MONEY_REST_VERSION=v2.0
MONEY_AGENDA_LABEL=TEST                       # TEST | PROD — never point development at PROD (CLAUDE.md §0)
MONEY_PAGE_SIZE=200
APPROVAL_JWT_PUBLIC_KEY=
