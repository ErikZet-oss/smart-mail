# Smart Mail — environment variables (CLAUDE.md §13). Copy to `.env` and fill in. NEVER commit `.env`.
# docker compose has safe defaults for local development; production needs every "required" value.

# ---------------------------------------------------------------- app (main service + worker)
APP_ENV=dev                                   # dev | test | prod
APP_BASE_URL=http://localhost:8080            # public URL of the web app (links in e-mails, OIDC redirects)
APP_SECRET_KEY=change-me                      # required in prod: random 64+ chars, signs sessions and CSRF tokens
APP_ENCRYPTION_KEY=                           # required in prod: Fernet key for mailbox passwords and tokens at rest
                                              #   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABASE_URL=postgresql+asyncpg://smartmail:smartmail@localhost:5432/smartmail
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:8333             # SeaweedFS S3 in compose (ADR-002); any S3-compatible storage in prod
S3_BUCKET=smartmail
S3_ACCESS_KEY=smartmail
S3_SECRET_KEY=smartmail-dev-secret
CLAMAV_HOST=localhost                         # attachments are scanned before processing (CLAUDE.md §11)
INTERNAL_DOMAINS=smartsro.sk                  # comma-separated; e-mail outside these = external (AI may never send)
LOG_LEVEL=INFO
SENTRY_DSN=                                   # optional

# ---------------------------------------------------------------- optional sign-in providers (default = mailbox login)
OIDC_MS_CLIENT_ID=
OIDC_MS_CLIENT_SECRET=
OIDC_MS_TENANT_ID=
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- Web Push (Phase 5)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------- AI (Phase 2, AI_ASSISTANT.md)
LLM_PROVIDER=anthropic                        # anthropic | bedrock (EU region recommended)
ANTHROPIC_API_KEY=
AWS_REGION=eu-central-1
LLM_MODEL_CLASSIFY=                           # model ids are configuration, never hard-coded
LLM_MODEL_DRAFT=
LLM_MODEL_EXTRACT=
LLM_MODEL_ASSISTANT=
LLM_MODEL_EMBED=
AI_DAILY_BUDGET_USD=5                         # hard daily cost cap; AI pauses when reached, mail keeps working

# ---------------------------------------------------------------- Money bridge client (main app side)
BRIDGE_URL=http://localhost:8100
BRIDGE_HMAC_KEY_ID=dev
BRIDGE_HMAC_SECRET=change-me                  # same value as in the bridge
APPROVAL_JWT_PRIVATE_KEY=                     # signs single-use approval tokens for Money writes (Phase 4)
ESHOP_FEED_URL=                               # optional product feed (Phase 6)

# ---------------------------------------------------------------- bridge service (runs in the LAN next to Money S4)
MONEY_BACKEND=mock                            # mock | api — keep mock until the TEST agenda and probe report exist
MONEY_BASE_URL=                               # e.g. https://money.local:44333 (TEST agenda first!)
MONEY_CLIENT_ID=
MONEY_CLIENT_SECRET=
MONEY_SCOPE=S5Api
MONEY_REST_VERSION=v2.0
MONEY_AGENDA_LABEL=TEST                       # TEST | PROD — never point development at PROD (CLAUDE.md §0)
MONEY_PAGE_SIZE=200
APPROVAL_JWT_PUBLIC_KEY=
